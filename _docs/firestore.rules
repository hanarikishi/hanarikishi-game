rules_version = '2';
// Firebase の「Firestore Database」→「ルール」に貼る。みんなの順位（ranks）だけを許す。
// 記録は 1人（匿名ログインの uid）につき、期間ごとに1件。いまより良いときだけ書きかえられる。
service cloud.firestore {
  match /databases/{database}/documents {
    match /ranks/{game}/{period}/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && valid();
      allow update: if request.auth != null && request.auth.uid == uid && valid()
        && (resource.data.dir == 'asc' ? request.resource.data.v <= resource.data.v : request.resource.data.v >= resource.data.v);
      allow delete: if false;

      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'v', 'dir', 't'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.v is number && d.v >= 0 && d.v <= 100000000
          && (d.dir == 'asc' || d.dir == 'desc')
          && d.t == request.time;
      }
    }
  }
}
